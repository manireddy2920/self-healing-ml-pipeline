# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://shlp:shlp_secret@postgres:5432/shlp
# For local development without Docker:
# DATABASE_URL=sqlite:///./shlp.db

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=shlp
MLFLOW_MODEL_NAME=credit_risk_champion

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_this_to_a_long_random_secret_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Serving ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Drift Detection ───────────────────────────────────────────────────────────
DRIFT_KS_THRESHOLD=0.05
DRIFT_PSI_THRESHOLD=0.2
DRIFT_LEARNED_AUC_THRESHOLD=0.65
DRIFT_COMPOSITE_THRESHOLD=0.5
DRIFT_DEBOUNCE_WINDOWS=2
DRIFT_COOLDOWN_MINUTES=30

# ── Retraining / Validation ───────────────────────────────────────────────────
VALIDATION_METRIC=f1
PROMOTION_THRESHOLD_DELTA=0.0          # challenger must beat champion by >= this
MAX_CONSECUTIVE_FAILURES=3             # flag for human review after N failures
TRAINING_WINDOW_DAYS=30

# ── Data ──────────────────────────────────────────────────────────────────────
DATA_DIR=./data
REFERENCE_PATH=./data/reference.parquet

# ── Prefect ───────────────────────────────────────────────────────────────────
PREFECT_API_URL=http://prefect-server:4200/api

# ── Dashboard ─────────────────────────────────────────────────────────────────
STREAMLIT_API_URL=http://api:8000
